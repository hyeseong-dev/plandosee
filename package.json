{
  "name": "plandosee",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cross-env RESET_TEST_DATA=true tsx prisma/seed.ts && playwright test",
    "test:e2e:production": "cross-env TEST_ENV=production playwright test",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e",
    "db:dev": "prisma dev --detach --name plandosee",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:test": "cross-env RESET_TEST_DATA=true tsx prisma/seed.ts",
    "db:seed:production": "cross-env ALLOW_PRODUCTION_SEED=true tsx prisma/seed-production.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.468.0",
    "next": "16.3.4",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "wanted-sans": "1.0.3",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^20",
    "@types/pg": "8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.1.1",
    "cross-env": "10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "28.1.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@11.16.0"
}

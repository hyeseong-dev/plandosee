generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  displayName       String
  passwordHash      String
  passwordChangedAt DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  sessions          Session[]
  plans             Plan[]
  diaryStudy        DiaryStudy?
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Plan {
  id               String                @id @default(uuid())
  userId           String?
  title            String
  startDate        DateTime              @db.Date
  endDate          DateTime              @db.Date
  priority         String
  successCriteria  String
  estimatedSeconds Int
  version          Int                   @default(1)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  revisions        PlanRevision[]
  todos            Todo[]
  review           Review?
  transfersIn      ImprovementTransfer[] @relation("TargetPlan")
  user             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PlanRevision {
  id               String   @id @default(uuid())
  planId           String
  version          Int
  title            String
  startDate        DateTime @db.Date
  endDate          DateTime @db.Date
  priority         String
  successCriteria  String
  estimatedSeconds Int
  createdAt        DateTime @default(now())
  plan             Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, version])
  @@index([planId])
}

model Todo {
  id               String            @id @default(uuid())
  planId           String
  content          String
  status           String            @default("IN_PROGRESS")
  dueDate          DateTime?         @db.Date
  priority         String
  tags             String[]          @default([])
  estimatedSeconds Int               @default(0)
  completionCycle  Int               @default(0)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  plan             Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  executionLogs    ExecutionLog[]
  completionEvents CompletionEvent[]

  @@index([planId, deletedAt])
  @@index([status, dueDate])
}

model ExecutionLog {
  id            String   @id @default(uuid())
  todoId        String
  startedAt     DateTime
  endedAt       DateTime
  actualSeconds Int
  blockedReason String?
  createdAt     DateTime @default(now())
  todo          Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@index([todoId])
}

model CompletionEvent {
  id          String   @id @default(uuid())
  todoId      String
  cycle       Int
  completedAt DateTime @default(now())
  todo        Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@unique([todoId, cycle])
  @@index([todoId])
}

model Review {
  id          String               @id @default(uuid())
  planId      String               @unique
  reflection  String               @default("")
  improvement String               @default("")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  plan        Plan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  transfer    ImprovementTransfer?
}

model ImprovementTransfer {
  id           String   @id @default(uuid())
  reviewId     String   @unique
  targetPlanId String
  content      String
  createdAt    DateTime @default(now())
  review       Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  targetPlan   Plan     @relation("TargetPlan", fields: [targetPlanId], references: [id], onDelete: Cascade)

  @@index([targetPlanId])
}

model DiaryStudy {
  id            String           @id @default(uuid())
  userId        String           @unique
  question      String
  metricName    String
  unit          String
  missingRule   String
  duplicateRule String
  outlierRule   String
  roundingRule  String
  weekStartsOn  String           @default("MONDAY")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries       DiaryEntry[]
  ruleChange    DiaryRuleChange?
}

model DiaryEntry {
  id        String     @id @default(uuid())
  studyId   String
  date      DateTime   @db.Date
  value     Float
  note      String     @default("")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  study     DiaryStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@unique([studyId, date])
  @@index([studyId, date])
}

model DiaryRuleChange {
  id             String     @id @default(uuid())
  studyId        String     @unique
  changedAt      DateTime
  reason         String
  beforeRule     String
  afterRule      String
  sourceEntryIds String[]   @default([])
  createdAt      DateTime   @default(now())
  study          DiaryStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
}
